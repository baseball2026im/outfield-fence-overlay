<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Baseball field — trial reference points (5 pins)</name>
    <description>Five named pins on the operational arc for the app-trial walk (tasks.md T3.3). Load this in each candidate iOS app to navigate by name; tape-measure home → each pin to score app accuracy.</description>
    <Style id="trial-pin"><IconStyle><color>ff00ffff</color><scale>1.3</scale></IconStyle></Style>
    <Placemark>
      <name>RF corner — trial</name>
      <description>1/5. 66.91 m at 236.23° from home plate.</description>
      <styleUrl>#trial-pin</styleUrl>
      <Point><coordinates>11.529623519580033,48.05108049069782,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>RF mid-arc — trial</name>
      <description>2/5. 77.20 m at 214.38° from home plate.</description>
      <styleUrl>#trial-pin</styleUrl>
      <Point><coordinates>11.529785193830715,48.05084184413892,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>CF apex — trial</name>
      <description>3/5. 79.98 m at 193.12° from home plate. Deepest point.</description>
      <styleUrl>#trial-pin</styleUrl>
      <Point><coordinates>11.530126997756286,48.05071421139396,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>LF mid-arc — trial</name>
