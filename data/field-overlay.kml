  <Document>
    <name>Baseball field — Grünwald (removable outfield fence overlay)</name>
    <description>Reproducible AR-overlay for the removable outfield fence at a BBSV U12 Schüler field. Operational small-variant arc + reference variants (Senior Tier 1, BBSV U15 Jugend) + surveyed waypoints. Generated by emit-arc-artifacts.py.</description>

    <Style id="arc-operational"><LineStyle><color>ff0000ff</color><width>4</width></LineStyle></Style>
    <Style id="arc-tier1"><LineStyle><color>aa00a5ff</color><width>2</width></LineStyle></Style>
    <Style id="arc-u15"><LineStyle><color>aa00cc00</color><width>2</width></LineStyle></Style>
    <Style id="backstop"><LineStyle><color>ff000000</color><width>3</width></LineStyle></Style>
    <Style id="soccer-pa"><LineStyle><color>ff800000</color><width>2</width></LineStyle><PolyStyle><color>40800000</color></PolyStyle></Style>
    <Style id="foul-line"><LineStyle><color>aa888888</color><width>1</width></LineStyle></Style>
    <Style id="home"><IconStyle><color>ff000000</color><scale>1.2</scale></IconStyle></Style>
    <Style id="base"><IconStyle><color>ff00ffff</color><scale>1.0</scale></IconStyle></Style>
    <Style id="mound"><IconStyle><color>ff00aa00</color><scale>1.0</scale></IconStyle></Style>
    <Style id="endpoint"><IconStyle><color>ff0000ff</color><scale>1.0</scale></IconStyle></Style>
    <Style id="trial-pin"><IconStyle><color>ff00ffff</color><scale>1.3</scale></IconStyle></Style>

