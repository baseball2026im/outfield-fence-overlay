    <Folder>
      <name>Trial reference points</name>
      <description>Five named points on the operational arc — RF corner, RF mid-arc, CF apex, LF mid-arc, LF corner. Used by the field-trial procedure (tasks.md T3.3) for app-side navigation and tape-measure verification. Distances are home → point in metres.</description>
    <Placemark>
      <name>RF corner — trial</name>
      <description>Trial reference point 1/5. Home → RF corner: 66.91 m at 236.23°. Same location as RF chalk endpoint.</description>
      <styleUrl>#trial-pin</styleUrl>
      <Point><coordinates>11.529623519580033,48.05108049069782,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>RF mid-arc — trial</name>
      <description>Trial reference point 2/5. Home → RF mid-arc: 77.20 m at 214.38°. Geodesic midpoint between RF corner and CF apex along the arc.</description>
      <styleUrl>#trial-pin</styleUrl>
      <Point><coordinates>11.529785193830715,48.05084184413892,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>CF apex — trial</name>
      <description>Trial reference point 3/5. Home → CF apex: 79.98 m at 193.12°. Deepest point of the arc.</description>
      <styleUrl>#trial-pin</styleUrl>
      <Point><coordinates>11.530126997756286,48.05071421139396,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>LF mid-arc — trial</name>
      <description>Trial reference point 4/5. Home → LF mid-arc: 74.96 m at 171.77°. Geodesic midpoint between CF apex and LF corner along the arc.</description>
      <styleUrl>#trial-pin</styleUrl>
      <Point><coordinates>11.530515180649552,48.05074753621319,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>LF corner — trial</name>
      <description>Trial reference point 5/5. Home → LF corner: 64.21 m at 151.85°. Same location as LF chalk endpoint.</description>
      <styleUrl>#trial-pin</styleUrl>
      <Point><coordinates>11.530778042628457,48.05090566272845,0</coordinates></Point>
    </Placemark>
    </Folder>

